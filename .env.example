# Copy to .env and fill in. Never commit .env.

# --- Apify ---
APIFY_TOKEN=
APIFY_ACTOR_ID=            # e.g. <username>/plainpath-gov-extractor
TARGET_START_URL=https://www.dmv.ca.gov/portal/
MAX_PAGES=300

# --- MongoDB Atlas ---
MONGODB_URI=
MONGODB_DB=plainpath

# --- Bitdeer AI Model Studio ---
BITDEER_API_KEY=
BITDEER_BASE_URL=https://api-inference.bitdeer.ai/v1
BITDEER_CHAT_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
EMBEDDING_MODEL=BAAI/bge-m3
BITDEER_REASONING_EFFORT=none   # none | low | medium | high (DeepSeek-V4.x thinking)

# --- Fetch.ai Agentverse ---
AGENTVERSE_API_KEY=
NAVIGATOR_SEED=            # any long random string; keeps agent address stable
CRAWLER_SEED=
ANSWER_SEED=
FORM_SEED=
AGENTS_PORT=8001            # Bureau port for all four agents

# --- Deployment ---
BACKEND_PUBLIC_URL=http://localhost:8000
# web/ (Next.js) server-side proxy target; set in web/.env.local or the hosting env
BACKEND_URL=http://localhost:8000

# --- Auth0 (bonus) ---
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# --- Apify webhook ---
APIFY_WEBHOOK_SECRET=       # any long random string; sent by Apify as X-PlainPath-Webhook-Secret
