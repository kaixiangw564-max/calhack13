# Copy to .env and fill in. Never commit .env.

# --- Apify ---
APIFY_TOKEN=
APIFY_ACTOR_ID=            # e.g. <username>/plainpath-gov-extractor
TARGET_START_URL=https://www.dmv.ca.gov/portal/
MAX_PAGES=300

# --- MongoDB Atlas ---
MONGODB_URI=
MONGODB_DB=plainpath

# --- Bitdeer AI Model Studio ---
BITDEER_API_KEY=
BITDEER_BASE_URL=
BITDEER_CHAT_MODEL=
EMBEDDING_MODEL=

# --- Fetch.ai Agentverse ---
AGENTVERSE_API_KEY=
NAVIGATOR_SEED=            # any long random string; keeps agent address stable
CRAWLER_SEED=
ANSWER_SEED=
FORM_SEED=

# --- Deployment ---
BACKEND_PUBLIC_URL=http://localhost:8000

# --- Auth0 (bonus) ---
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
